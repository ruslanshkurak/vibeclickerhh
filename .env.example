# API Ключ от Google AI Studio (получить бесплатно на ai.google.dev)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Модель Gemini (gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Настройки поиска на hh.ru
HH_SEARCH_QUERY=Golang
HH_AREA=113

# Минимальная оценка соответствия вакансии вашему резюме (от 1 до 10)
MIN_FIT_SCORE=6

# Максимальное количество откликов за один запуск (чтобы избежать блокировок от hh.ru)
MAX_APPLIES_PER_RUN=80

# Максимальное количество пустых страниц подряд
MAX_EMPTY_PAGES=0

# Предел ранее обработанных вакансий подряд
MAX_CONSECUTIVE_PROCESSED_SKIPS=100

# Запуск браузера в фоновом режиме (True) или в видимом (False)
HEADLESS=False

# Черный список работодателей (названия через запятую, без пробелов, регистр не важен)
BLACKLIST_EMPLOYERS=сбер,т-банк,тинькофф,ozon,озон

# Целевой грейд (информация для ИИ при генерации и оценке)
TARGET_GRADE=Middle, Middle+, Senior

# Грейды, на которые бот НЕ должен откликаться (через запятую)
EXCLUDE_GRADES=junior,lead,intern,стажер,младший,джун,tech lead,техлид

# Ночной режим (True/False)
NIGHT_MODE=True

# Персонализация ИИ-сопроводительных писем
USER_CONTACTS=С уважением,\n[Ваше Имя]\nТГ: @[ваш_телеграм]

# Пожелания к стилю/тону письма
USER_SPECIAL_WISHES=пиши в уверенном профессиональном тоне, делай упор на сильные инженерные навыки

RESUME_FROM_LAST_PAGE=True
LAST_SEARCH_PAGE=0
WORK_TIME_HOURS=0
WORK_TIME_MINUTES=0
